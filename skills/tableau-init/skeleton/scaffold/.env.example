# =============================================================================
# Tableau connection for the published-datasource route (VizQL Data Service).
# Copy this file to .env at the project ROOT before use. NEVER commit .env.
# Requires Tableau Cloud, or Tableau Server 2025.1+, with VDS "API Access" enabled
# on the data source. Only needed for the published-ds route — the CSV route needs
# no credentials.
# =============================================================================

# --- Tableau site ---
# TABLEAU_SERVER=https://10ax.online.tableau.com   # your pod / server URL
# TABLEAU_SITE=your_site_content_url               # leave empty for the default site
# TABLEAU_API_VERSION=3.24

# --- Personal Access Token (preferred auth) ---
# A PAT sign-in returns a credentials token valid for the REST API and the
# VizQL Data Service. Create a PAT under your Tableau account settings.
# TABLEAU_PAT_NAME=your_token_name
# TABLEAU_PAT_SECRET=your_token_secret
